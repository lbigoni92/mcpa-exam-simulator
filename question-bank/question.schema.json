{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCPA practice question",
  "type": "object",
  "required": ["id", "domain", "competency", "topic_id", "type", "difficulty", "stem", "options", "correct", "explanation", "references"],
  "properties": {
    "id": { "type": "string", "description": "es. D3-MRTR-0007" },
    "domain": { "enum": ["D1", "D2", "D3", "D4", "D5"] },
    "competency": { "type": "string", "description": "Competenza ufficiale LF (vedi knowledge/manifest.json)" },
    "topic_id": { "type": "string", "description": "id del topic nel manifest, es. D3-04" },
    "type": { "enum": ["single", "multiple"], "description": "single = una risposta corretta; multiple = 'seleziona N'" },
    "difficulty": { "enum": ["base", "intermedio", "avanzato"] },
    "stem": { "type": "string", "description": "Testo della domanda (italiano, termini tecnici in inglese)" },
    "code": { "type": "string", "description": "Snippet JSON/HTTP opzionale mostrato con la domanda" },
    "options": {
      "type": "array", "minItems": 4, "maxItems": 6,
      "items": { "type": "object", "required": ["key", "text"],
        "properties": { "key": { "enum": ["A", "B", "C", "D", "E", "F"] }, "text": { "type": "string" }, "why_wrong": { "type": "string" } } }
    },
    "correct": { "type": "array", "items": { "enum": ["A", "B", "C", "D", "E", "F"] }, "minItems": 1 },
    "explanation": { "type": "string" },
    "references": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["url"],
        "properties": { "url": { "type": "string" }, "local": { "type": "string" }, "section": { "type": "string" } } }
    },
    "spec_version": { "const": "2026-07-28" },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "es. new-in-2026-07-28, oauth, mrtr, distractor-legacy" }
  }
}
